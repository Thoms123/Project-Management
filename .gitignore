# Ringkasan task-nya ada di .github/roadmap.yml.
# ---------------------------------------------------------------------------
/PRD/
/stitch_web_app_figma_mockup/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

