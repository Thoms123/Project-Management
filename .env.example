# Salin ke .env lalu sesuaikan. File .env tidak pernah di-commit.
#
#   cp .env.example .env

# --- Database --------------------------------------------------------------
# Cocok dengan docker-compose.yml. Jalankan `pnpm db:up` lebih dulu.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rilis_tanpa_lupa?schema=public"

# --- Backend (apps/api) ----------------------------------------------------
API_PORT=3001

# Asal frontend yang boleh memanggil API ini (CORS). Pisahkan dengan koma
# bila lebih dari satu. Ini alamat apps/web, bukan alamat API-nya sendiri.
WEB_ORIGIN="http://localhost:3000"

# Kunci penandatangan JWT. WAJIB diganti di luar development.
# Bangkitkan dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-nilai-acak-yang-panjang"
JWT_EXPIRES_IN="7d"

# Kunci enkripsi nilai rahasia (variabel env & query database milik pengguna).
# Harus 32 byte dalam base64. Bangkitkan dengan: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY="ganti-dengan-kunci-32-byte-base64"

# --- Frontend (apps/web) ---------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
